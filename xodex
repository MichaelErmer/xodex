update_quota_cache_once() {
  local requested="${1:-}"
  local skip_active="${2:-0}"
  local active=""
  local entry
  local name
  local found=0
  local status=0

  ensure_store
  [ -f "$CURRENT_FILE" ] && active="$(cat "$CURRENT_FILE")"

  if [ -n "$requested" ]; then
    require_profile_name "$requested"
    [ -d "$(profile_dir "$requested")" ] || die "unknown profile: $requested"
  fi

  if ! acquire_quota_lock; then
    write_quota_bar
    return 0
  fi

  if [ -n "$requested" ]; then
    fetch_quota_for_profile "$requested" || status=$?
    write_quota_bar
    release_quota_lock
    return "$status"
  fi

  for entry in "$STORE"/*; do
    [ -d "$entry" ] || continue
    name="$(basename "$entry")"
    [ "$name" = ".backups" ] && continue
    if [ "$skip_active" = "1" ] && [ "$name" = "$active" ]; then
      continue
    fi
    found=1
    fetch_quota_for_profile "$name" || status=$?
  done

  [ "$found" -eq 1 ] || true
  write_quota_bar
  release_quota_lock
  return "$status"
}

quota_cache_line() {
  local file="$1"
  local active="${2:-}"

  jq -r --arg active "$active" '
    def repeat_char($ch; $n):
      if $n <= 0 then "" else reduce range(0; $n) as $i (""; . + $ch) end;
    def clamp_percent($value):
      (($value // 0) | tonumber) as $pct
      | if $pct < 0 then 0 elif $pct > 100 then 100 else $pct end;
    def progress_bar($remaining):
      clamp_percent($remaining) as $pct
      | (($pct / 10) | floor) as $filled
      | "[" + repeat_char("#"; $filled) + repeat_char("-"; 10 - $filled) + "]";
    def display_name:
      if .profile == $active then "*\(.profile)" else .profile end;
    def reset_prefix:
      if (.reset_alert.active // false) then "RESET " else "" end;
    if .status == "ok" then
      "\(reset_prefix)\(display_name) \(progress_bar(.remaining_percent))\((.remaining_percent // 0) | floor)% \(.window_label // "quota") \(.reset_label // "unknown")"
    elif .status == "missing" then
      "\(display_name) unavailable"
    else
      "\(display_name) error"
    end
  ' "$file" 2>/dev/null || true
}

quota_reset_alert_active() {
  local entry

  for entry in "$QUOTA_DIR"/*.json; do
    [ -f "$entry" ] || continue
    if jq -e '(.reset_alert.active // false) == true' "$entry" >/dev/null 2>&1; then
      return 0
    fi
  done

  return 1
}

clear_quota_reset_alerts() {
  local entry
  local tmp

  ensure_store
  for entry in "$QUOTA_DIR"/*.json; do
    [ -f "$entry" ] || continue
    tmp="$entry.tmp.$$"
    if jq 'del(.reset_alert)' "$entry" > "$tmp" 2>/dev/null; then
      chmod 600 "$tmp"
      mv "$tmp" "$entry"
    else
      rm -f "$tmp"
    fi
  done
  write_quota_bar
}

quota_bar_text() {
  local active=""
  local entry
  local name
  local line
  local output=""
  local count=0
  local active_entry=""

  ensure_store
  [ -f "$CURRENT_FILE" ] && active="$(cat "$CURRENT_FILE")"

  if [ -n "$active" ]; then
    active_entry="$QUOTA_DIR/$active.json"
    if [ -f "$active_entry" ]; then
      line="$(quota_cache_line "$active_entry" "$active")"
      if [ -n "$line" ]; then
        output="$line"
        count=1
      fi
    fi
  fi

  for entry in "$QUOTA_DIR"/*.json; do
    [ -f "$entry" ] || continue
    name="$(jq -r '.profile // empty' "$entry" 2>/dev/null || true)"
    [ -n "$name" ] || continue
    [ "$name" = "$active" ] && continue
    line="$(quota_cache_line "$entry" "$active")"
    [ -n "$line" ] || continue
    if [ "$count" -eq 0 ]; then
      output="$line"
    else
      output="$output  |  $line"
    fi
    count=$((count + 1))
  done

  if [ "$count" -eq 0 ]; then
    printf 'pending'
  else
    printf '%s' "$output"
  fi
}

write_quota_bar() {
  local tmp="$QUOTA_BAR_FILE.tmp.$$"

  quota_bar_text > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$QUOTA_BAR_FILE"
}

show_quota() {
  local requested="${1:-}"
  local file

  update_quota_cache_once "$requested" 0 >/dev/null 2>&1 || true
  if [ -n "$requested" ]; then
    file="$QUOTA_DIR/$requested.json"
    [ -f "$file" ] && quota_cache_line "$file" "$(cat "$CURRENT_FILE" 2>/dev/null || true)"
    return
  fi
  quota_bar_text
  printf '\n'
}

start_quota_monitor() {
  local existing_pid=""

  [ "$QUOTA_BAR_ENABLED" != "0" ] || return 0
  ensure_store
  write_quota_bar

  if [ -f "$QUOTA_PID_FILE" ]; then
    existing_pid="$(cat "$QUOTA_PID_FILE" 2>/dev/null || true)"
    if pid_is_running "$existing_pid"; then
      return 0
    fi
    rm -f "$QUOTA_PID_FILE"
  fi

  command -v jq >/dev/null 2>&1 || return 0
  command -v curl >/dev/null 2>&1 || return 0

  : > "$QUOTA_LOG_FILE"
  chmod 600 "$QUOTA_LOG_FILE"
  if command -v nohup >/dev/null 2>&1; then
    nohup "$0" _quota-daemon >> "$QUOTA_LOG_FILE" 2>&1 &
  else
    "$0" _quota-daemon >> "$QUOTA_LOG_FILE" 2>&1 &
  fi
  printf '%s\n' "$!" > "$QUOTA_PID_FILE"
  chmod 600 "$QUOTA_PID_FILE"
}

quota_daemon() {
  local interval
  local quota_sleep_pid=""

  ensure_store
  interval="$(quota_interval_seconds)"
  trap 'rm -f "$QUOTA_PID_FILE"' EXIT
  trap 'rm -f "$QUOTA_PID_FILE"; [ -z "${quota_sleep_pid:-}" ] || kill "$quota_sleep_pid" 2>/dev/null || true; exit 0' INT TERM
  printf '%s\n' "$$" > "$QUOTA_PID_FILE"
  chmod 600 "$QUOTA_PID_FILE"

  while true; do
    update_quota_cache_once "" 0 || true
    sleep "$interval" &
    quota_sleep_pid="$!"
    wait "$quota_sleep_pid" || true
    quota_sleep_pid=""
  done
}

show_quota_status() {
  local pid=""

  ensure_store
  [ -f "$QUOTA_PID_FILE" ] && pid="$(cat "$QUOTA_PID_FILE" 2>/dev/null || true)"
  if pid_is_running "$pid"; then
    printf 'running pid=%s\n' "$pid"
  else
    printf 'stopped\n'
  fi
  printf 'interval_seconds=%s\n' "$(quota_interval_seconds)"
  printf 'cache_max_age_seconds=%s\n' "$(quota_cache_max_age_seconds)"
  printf 'lock_max_age_seconds=%s\n' "$(quota_lock_max_age_seconds)"
  printf 'reset_drop_threshold_percent=%s\n' "$(quota_reset_drop_threshold_percent)"
  printf 'fetch_timeout_seconds=%s\n' "$(quota_fetch_timeout_seconds)"
  printf 'overlay_align=%s\n' "$QUOTA_OVERLAY_ALIGN"
  printf 'overlay_max_width=%s\n' "$(quota_overlay_max_width)"
  printf 'bar=%s\n' "$QUOTA_BAR_FILE"
  printf 'lock=%s\n' "$QUOTA_LOCK_FILE"
  printf 'log=%s\n' "$QUOTA_LOG_FILE"
}

quota_bar_should_overlay() {
  case "$QUOTA_BAR_ENABLED" in
    0|false|FALSE|off|OFF|no|NO)
      return 1
      ;;
    1|true|TRUE|on|ON|yes|YES)
      [ -t 0 ] && [ -t 1 ]
      return
      ;;
  esac

  [ -t 0 ] && [ -t 1 ] && [ -w /dev/tty ]
}

draw_quota_overlay_once() {
  local cols
  local bar
  local title='XODEX | Quotas:'
  local title_len
  local align="$QUOTA_OVERLAY_ALIGN"
  local max_width
  local body_width
  local body_text
  local badge_width
  local start_col
  local end_col
  local clear_start
  local clear_end
  local clear_width
  local previous_start=""
  local previous_width=""
  local previous_cols=""
  local previous_text=""
  local previous_drawn_at=""
  local previous_end
  local previous_valid=0
  local now
  local line
  local rest_width
  local badge_text
  local alert_active=0
  local title_bg='48;5;27'
  local title_fg='38;5;15'
  local body_bg='48;5;236'
  local body_fg='38;5;250'

  [ -w /dev/tty ] || return 0
  cols="$(terminal_cols)"
  bar="$(quota_bar_text)"
  if quota_reset_alert_active; then
    alert_active=1
    if [ $(( $(now_epoch) % 2 )) -eq 0 ]; then
      title='OPENAI RESET:'
      title_bg='48;5;196'
      title_fg='38;5;15'
      body_bg='48;5;52'
      body_fg='38;5;226'
    else
      title='OPENAI RESET:'
      title_bg='48;5;226'
      title_fg='38;5;16'
      body_bg='48;5;196'
      body_fg='38;5;15'
    fi
  fi
  title_len="${#title}"

  case "$align" in
    full|FULL)
      if [ "$cols" -le "$title_len" ]; then
        printf '\0337\033[1;1H\033[%sm\033[%sm\033[1m%-*.*s\033[0m\0338' "$title_bg" "$title_fg" "$cols" "$cols" "$title" >/dev/tty
        return 0
      fi
      rest_width=$((cols - title_len))
      {
        printf '\0337\033[1;1H'
        printf '\033[%sm\033[%sm\033[1m%-*.*s' "$title_bg" "$title_fg" "$title_len" "$title_len" "$title"
        printf '\033[%sm\033[%sm %-*.*s\033[0m\0338' "$body_bg" "$body_fg" "$((rest_width - 1))" "$((rest_width - 1))" "$bar"
      } >/dev/tty
      return 0
      ;;
  esac

  max_width="$(quota_overlay_max_width)"
  if [ "$max_width" -le 0 ]; then
    max_width="$cols"
  fi
  [ "$max_width" -gt "$cols" ] && max_width="$cols"
  [ "$max_width" -lt "$title_len" ] && max_width="$title_len"

  body_width=$((max_width - title_len - 1))
  if [ "$body_width" -le 0 ]; then
    body_text=""
  elif [ "${#bar}" -gt "$body_width" ]; then
    if [ "$body_width" -gt 3 ]; then
      body_text="${bar:0:$((body_width - 3))}..."
    else
      body_text="${bar:0:$body_width}"
    fi
  else
    body_text="$bar"
  fi

  badge_width="$title_len"
  if [ -n "$body_text" ]; then
    badge_width=$((badge_width + 1 + ${#body_text}))
  fi
  start_col=$((cols - badge_width + 1))
  [ "$start_col" -lt 1 ] && start_col=1
  end_col=$((start_col + badge_width - 1))
  clear_start="$start_col"
  clear_end="$end_col"

  if [ -f "$QUOTA_OVERLAY_STATE_FILE" ]; then
    while IFS= read -r line; do
      case "$line" in
        start=*) previous_start="${line#*=}" ;;
        width=*) previous_width="${line#*=}" ;;
        cols=*) previous_cols="${line#*=}" ;;
        text=*) previous_text="${line#*=}" ;;
        drawn_at=*) previous_drawn_at="${line#*=}" ;;
      esac
    done < "$QUOTA_OVERLAY_STATE_FILE"
    case "$previous_start" in
      ""|*[!0-9]*) previous_width="" ;;
    esac
    case "$previous_width" in
      ""|*[!0-9]*) ;;
      *)
        previous_valid=1
        [ "$previous_start" -lt "$clear_start" ] && clear_start="$previous_start"
        previous_end=$((previous_start + previous_width - 1))
        [ "$previous_end" -gt "$clear_end" ] && clear_end="$previous_end"
        ;;
    esac
  fi
  [ "$clear_end" -gt "$cols" ] && clear_end="$cols"
  clear_width=$((clear_end - clear_start + 1))
  badge_text="$title $body_text"
  now="$(now_epoch)"

  if [ "$alert_active" -eq 0 ] && [ "$previous_valid" -eq 1 ] && [ "$previous_cols" = "$cols" ] && [ "$previous_text" = "$badge_text" ]; then
    case "$previous_drawn_at" in
      ""|*[!0-9]*) ;;
      *)
        if [ $((now - previous_drawn_at)) -lt 30 ]; then
          return 0
        fi
        ;;
    esac
  fi

  {
    printf '\0337'
    printf '\033[1;%sH\033[0m%-*s' "$clear_start" "$clear_width" ""
    printf '\033[1;%sH' "$start_col"
    printf '\033[%sm\033[%sm\033[1m%s' "$title_bg" "$title_fg" "$title"
    if [ -n "$body_text" ]; then
      printf '\033[%sm\033[%sm %s' "$body_bg" "$body_fg" "$body_text"
    fi
    printf '\033[0m\0338'
  } >/dev/tty

  {
    printf 'start=%s\n' "$start_col"
    printf 'width=%s\n' "$badge_width"
    printf 'cols=%s\n' "$cols"
    printf 'text=%s\n' "$badge_text"
    printf 'drawn_at=%s\n' "$now"
  } > "$QUOTA_OVERLAY_STATE_FILE"
  chmod 600 "$QUOTA_OVERLAY_STATE_FILE"
}

clear_quota_overlay() {
  local cols
  local start=""
  local width=""
  local line

  [ -w /dev/tty ] || return 0
  cols="$(terminal_cols)"
  if [ -f "$QUOTA_OVERLAY_STATE_FILE" ]; then
    while IFS= read -r line; do
      case "$line" in
        start=*) start="${line#*=}" ;;
        width=*) width="${line#*=}" ;;
      esac
    done < "$QUOTA_OVERLAY_STATE_FILE"
  fi
  case "$start" in
    ""|*[!0-9]*) return 0 ;;
  esac
  case "$width" in
    ""|*[!0-9]*) return 0 ;;
  esac
  [ "$start" -lt 1 ] && start=1
  [ "$start" -gt "$cols" ] && return 0
  [ $((start + width - 1)) -gt "$cols" ] && width=$((cols - start + 1))
  printf '\0337\033[1;%sH\033[0m%-*s\0338' "$start" "$width" "" >/dev/tty
  rm -f "$QUOTA_OVERLAY_STATE_FILE"
}

quota_overlay_loop() {
  local parent_pid="${1:-}"

  trap 'exit 0' INT TERM HUP
  while true; do
    if [ -n "$parent_pid" ] && ! pid_is_running "$parent_pid"; then
      exit 0
    fi
    draw_quota_overlay_once
    if quota_reset_alert_active; then
      sleep 1
    else
      sleep 5
    fi
  done
}

cleanup_quota_overlay_pid() {
  local pid="${1:-}"

  if pid_is_running "$pid"; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  clear_quota_overlay
}

run_codex_command() {
  local overlay_pid=""
  local parent_pid
  local status

  if quota_bar_should_overlay; then
    start_quota_monitor
    parent_pid="${BASHPID:-$$}"
    quota_overlay_loop "$parent_pid" &
    overlay_pid="$!"
    trap 'cleanup_quota_overlay_pid "$overlay_pid"; exit 130' INT
    trap 'cleanup_quota_overlay_pid "$overlay_pid"; exit 143' TERM
    trap 'cleanup_quota_overlay_pid "$overlay_pid"; exit 129' HUP
    trap 'cleanup_quota_overlay_pid "$overlay_pid"' EXIT
    set +e
    "$CODEX_BIN" "$@"
    status=$?
    set -e
    cleanup_quota_overlay_pid "$overlay_pid"
    overlay_pid=""
    trap - EXIT INT TERM HUP
    return "$status"
  fi

  set +e
  "$CODEX_BIN" "$@"
  status=$?
  set -e
  return "$status"
}

pid_is_running() {
  local pid="$1"

  case "$pid" in
    ""|*[!0-9]*)
      return 1
      ;;
  esac
  kill -0 "$pid" >/dev/null 2>&1
}

read_refresh_lock_field() {
  local key="$1"
  local line

  [ -f "$REFRESH_LOCK_FILE" ] || return 1
  while IFS= read -r line; do
    case "$line" in
      "$key="*)
        printf '%s\n' "${line#*=}"
        return 0
        ;;
    esac
  done < "$REFRESH_LOCK_FILE"

  return 1
}

acquire_refresh_lock() {
  local now
  local max_age
  local lock_created
  local lock_pid
  local lock_owner
  local age

  ensure_store
  max_age="$(refresh_lock_max_age_seconds)"

  while true; do
    now="$(now_epoch)"
    REFRESH_LOCK_OWNER="$$:${BASHPID:-$$}:$RANDOM:$now"
    if (
      set -o noclobber
      umask 077
      {
        printf 'owner=%s\n' "$REFRESH_LOCK_OWNER"
        printf 'pid=%s\n' "$$"
        printf 'created_at=%s\n' "$now"
      } > "$REFRESH_LOCK_FILE"
    ) 2>/dev/null; then
      return 0
    fi

    lock_created="$(read_refresh_lock_field created_at 2>/dev/null || true)"
    lock_pid="$(read_refresh_lock_field pid 2>/dev/null || true)"
    lock_owner="$(read_refresh_lock_field owner 2>/dev/null || true)"

    case "$lock_created" in
      ""|*[!0-9]*)
        age="$max_age"
        ;;
      *)
        age=$((now - lock_created))
        ;;
    esac

    if [ "$age" -ge "$max_age" ]; then
      log_refresh "Ignoring stale refresh lock owner=${lock_owner:-unknown} pid=${lock_pid:-unknown} age=${age}s max_age=${max_age}s"
      rm -f "$REFRESH_LOCK_FILE"
      continue
    fi

    log_refresh "Refresh already running owner=${lock_owner:-unknown} pid=${lock_pid:-unknown} age=${age}s"
    return 1
  done
}

release_refresh_lock() {
  local lock_owner

  [ -f "$REFRESH_LOCK_FILE" ] || return 0
  lock_owner="$(read_refresh_lock_field owner 2>/dev/null || true)"
  if [ -n "${REFRESH_LOCK_OWNER:-}" ] && [ "$lock_owner" = "$REFRESH_LOCK_OWNER" ]; then
    rm -f "$REFRESH_LOCK_FILE"
  fi
}

start_refresher() {
  local existing_pid=""

  [ "$REFRESH_ENABLED" != "0" ] || return 0
  ensure_store

  if [ -f "$REFRESH_PID_FILE" ]; then
    existing_pid="$(cat "$REFRESH_PID_FILE" 2>/dev/null || true)"
    if pid_is_running "$existing_pid"; then
      return 0
    fi
    rm -f "$REFRESH_PID_FILE"
  fi

  command -v jq >/dev/null 2>&1 || {
    printf 'xodex: background refresh disabled because jq is not installed\n' >&2
    return 0
  }
  command -v curl >/dev/null 2>&1 || {
    printf 'xodex: background refresh disabled because curl is not installed\n' >&2
    return 0
  }

  : > "$REFRESH_LOG_FILE"
  chmod 600 "$REFRESH_LOG_FILE"
  if command -v nohup >/dev/null 2>&1; then
    nohup "$0" _refresh-daemon >> "$REFRESH_LOG_FILE" 2>&1 &
  else
    "$0" _refresh-daemon >> "$REFRESH_LOG_FILE" 2>&1 &
  fi
  printf '%s\n' "$!" > "$REFRESH_PID_FILE"
  chmod 600 "$REFRESH_PID_FILE"
}

refresh_daemon() {
  local interval
  local refresh_sleep_pid=""

  ensure_store
  interval="$(refresh_interval_seconds)"

  trap 'release_refresh_lock; rm -f "$REFRESH_PID_FILE"' EXIT
  trap 'release_refresh_lock; rm -f "$REFRESH_PID_FILE"; [ -z "${refresh_sleep_pid:-}" ] || kill "$refresh_sleep_pid" 2>/dev/null || true; exit 0' INT TERM
  printf '%s\n' "$$" > "$REFRESH_PID_FILE"
  chmod 600 "$REFRESH_PID_FILE"
  log_refresh "Refresh daemon started; interval=${interval}s"

  while true; do
    refresh_saved_profiles_once "" 1 || true
    sleep "$interval" &
    refresh_sleep_pid="$!"
    wait "$refresh_sleep_pid" || true
    refresh_sleep_pid=""
  done
}

show_refresh_status() {
  local pid=""

  ensure_store
  [ -f "$REFRESH_PID_FILE" ] && pid="$(cat "$REFRESH_PID_FILE" 2>/dev/null || true)"
  if pid_is_running "$pid"; then
    printf 'running pid=%s\n' "$pid"
  else
    printf 'stopped\n'
  fi
  printf 'interval_seconds=%s\n' "$(refresh_interval_seconds)"
  printf 'refresh_window_seconds=%s\n' "$(refresh_window_seconds)"
  printf 'lock_max_age_seconds=%s\n' "$(refresh_lock_max_age_seconds)"
  printf 'lock=%s\n' "$REFRESH_LOCK_FILE"
  printf 'log=%s\n' "$REFRESH_LOG_FILE"
}

run_codex_with_profile() {
  local name="$1"
  local status

  shift
  require_profile_name "$name"
  use_profile "$name"
  if command -v jq >/dev/null 2>&1; then
    clear_quota_reset_alerts
  fi
  start_refresher

  command -v "$CODEX_BIN" >/dev/null 2>&1 || die "codex command not found: $CODEX_BIN"
  set +e
  run_codex_command "$@"
  status=$?
  set -e
  autosave_current_profile
  return "$status"
}

current_profile_name() {
  local name=""

  ensure_store
  [ -f "$CURRENT_FILE" ] || die "no current profile is marked; use xodex use <name> or xodex save <name>"
  name="$(cat "$CURRENT_FILE")"
  require_profile_name "$name"
  [ -d "$(profile_dir "$name")" ] || die "current profile is unknown: $name"
  printf '%s\n' "$name"
}

run_codex_with_current_profile() {
  local name

  name="$(current_profile_name)"
  run_codex_with_profile "$name" "$@"
}

new_empty_profile() {
  local name="$1"
  local target
  local file

  require_profile_name "$name"
  require_codex_home
  ensure_store

  target="$(profile_dir "$name")"
  [ ! -e "$target" ] || die "profile already exists: $name"

  autosave_current_profile
  backup_active_profile_files

  mkdir -p "$target"
  chmod 700 "$target"

  for file in "${PROFILE_FILES[@]}"; do
    rm -f "$CODEX_HOME/$file" "$target/$file"
  done

  write_meta "$name" "$target"
  printf '%s\n' "$name" > "$CURRENT_FILE"
  chmod 600 "$CURRENT_FILE"

  printf 'Created empty Codex profile %s\n' "$name"
  printf 'Switched Codex profile to %s\n' "$name"
  printf 'Active OpenAI login cleared; Codex will need a login for this profile.\n'
  printf 'Shared config kept in place: %s/config.toml\n' "$CODEX_HOME"
  printf 'Sessions kept in place: %s/sessions\n' "$CODEX_HOME"
}

list_profiles() {
  local current=""
  local entry
  local name
  local found=0

  ensure_store
  [ -f "$CURRENT_FILE" ] && current="$(cat "$CURRENT_FILE")"

  for entry in "$STORE"/*; do
    [ -d "$entry" ] || continue
    name="$(basename "$entry")"
    [ "$name" = ".backups" ] && continue
    found=1
    if [ "$name" = "$current" ]; then
      printf '* %s\n' "$name"
    else
      printf '  %s\n' "$name"
    fi
  done

  [ "$found" -eq 1 ] || printf 'No saved profiles in %s\n' "$STORE"
}

show_current() {
  if [ -f "$CURRENT_FILE" ]; then
    cat "$CURRENT_FILE"
  else
    printf 'unknown\n'
  fi
}

show_where() {
  printf 'CODEX_HOME=%s\n' "$CODEX_HOME"
  printf 'PROFILE_STORE=%s\n' "$STORE"
  printf 'SESSIONS=%s/sessions\n' "$CODEX_HOME"
  printf 'REFRESH_LOG=%s\n' "$REFRESH_LOG_FILE"
  printf 'QUOTA_BAR=%s\n' "$QUOTA_BAR_FILE"
}

main() {
  local command="${1:-}"

  case "$command" in
    run)
      shift
      run_codex_with_profile "${1:-}" "${@:2}"
      ;;
    save|capture)
      shift
      save_profile "${1:-}"
      ;;
    use|switch)
      shift
      use_profile "${1:-}"
      ;;
    new|create|empty)
      shift
      new_empty_profile "${1:-}"
      ;;
    refresh)
      shift
      refresh_saved_profiles_once "${1:-}" 0
      ;;
    refresh-status|status)
      show_refresh_status
      ;;
    quota)
      shift
      show_quota "${1:-}"
      ;;
    quota-status)
      show_quota_status
      ;;
    _refresh-daemon)
      refresh_daemon
      ;;
    _quota-daemon)
      quota_daemon
      ;;
    _quota-bar)
      quota_bar_text
      ;;
    list|ls)
      list_profiles
      ;;
    current)
      show_current
      ;;
    where)
      show_where
      ;;
    "")
      run_codex_with_current_profile
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      if profile_exists "$command"; then
        run_codex_with_profile "$@"
      else
        usage >&2
        die "unknown command or profile: $command"
      fi
      ;;
  esac
}

main "$@"
